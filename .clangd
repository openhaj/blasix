# clangd configuration for this project.
#
# clangd reads compile_commands.json to know how to compile each
# file. This file adds or removes flags on top of that for better
# static analysis.

CompileFlags:
  # Flags to add for analysis.
  Add:
    - -Iinclude
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wconversion
    - -Wsign-conversion
    - -Wcast-align
    - -Wstrict-prototypes
    - -Wmissing-prototypes
    - -Wmissing-declarations
    - -Wold-style-definition
    - -Wpointer-arith
    - -Wwrite-strings
    - -Wundef
    - -Wredundant-decls
    - -Wnested-externs
    - -Wno-unused-parameter
    - -Wno-reserved-identifier
    - -Wno-reserved-macro-identifier
    - -std=c11

---
# Test units: the Makefile derives these from src/suites/<cat>/<func>.c.
If:
  PathMatch: src/suites/.*\.[ch]
CompileFlags:
  Add:
    - -DLC_CATEGORY="suite"
    - -DLC_FUNCTION="suite"
    - -fno-builtin
    # The widest target (C23 + POSIX.1-2024 + XSI), so that the host
    # headers declare every interface. Editor only: make never reads this
    # file, a unit is built with the flags of the target (spec.mk).
    # Comes after the -std=c11 above: the last -std wins.
    - -std=c23
    - -D_POSIX_C_SOURCE=202405L
    - -D_XOPEN_SOURCE=800
# What the host headers still do not declare (interfaces removed from
# the host, or that only the libc under test has). The build still
# catches a real mistake: the unit is unavailable, with its .err file.
Diagnostics:
  Suppress:
    - ext_implicit_function_decl_c99   # Call to undeclared function 'x'
    - err_unknown_typename             # Unknown type name 'x'
    - err_undeclared_var_use           # Use of undeclared identifier 'x'
