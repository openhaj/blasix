# target.mk - the target (what the libc is checked against) and what it
# selects: feature-test macros, units, probes.
#
#   STD=posix-2024   c99 c11 c17 c23 posix-2001 posix-2008 posix-2017 posix-2024
#   OPTS=XSI         option groups, comma list (make options): POSIX ones
#                    (XSI, TSF, ...; only on a POSIX target, default XSI) and
#                    ISO C conditional features (THREADS, COMPLEX, LIB_EXT1, ...)
#   EXT=0            1: also the extensions (GNU, BSD) listed in spec/
#   LAX=0            1: lax mode. Strict (default): every interface the
#                    target does not require and whose name is not reserved
#                    for the header must be hidden (hidden probes, "leak"
#                    column). Lax: not checked, and units / probes are also
#                    built with LIBC_LAX_CFLAGS (the profile's macros that
#                    expose everything, e.g. -D_DEFAULT_SOURCE), so that a
#                    function the header hides in strict mode is still tested
#   CAT=a,b FUNC=f   only these categories / functions

LIBC		?= host
STD			?= posix-2024
OPTS		?= $(if $(filter posix-%,$(STD)),XSI)
EXT			?= 0
LAX			?= 0
PROBE		?= 1
COV			?= 0

TARGET		:= $(STD)$(if $(OPTS),+$(subst $(comma),+,$(OPTS)))$(if $(filter 1,$(EXT)),+ext)$(if $(filter 1,$(LAX)),+lax)
OUT			:= $(BUILD_DIR)/$(LIBC)/$(TARGET)
LCTARGET	:= -S $(STD) $(if $(OPTS),-O $(OPTS)) $(if $(filter 1,$(EXT)),-E) $(if $(filter 1,$(LAX)),-x)
LCPATHS		:= -s $(SUITES_DIR) -p $(SPEC_DIR)

# The libc profile (LIBC_CC, LIBC_CPPFLAGS, ..., libc-prepare).
ifeq ($(filter $(LIBC),$(LIBC_PROFILES)),)
$(error LIBC=$(LIBC): no profile mk/libc/$(LIBC).mk (have: $(LIBC_PROFILES)))
endif
include mk/libc/$(LIBC).mk

# Lax mode only: what the profile adds to expose every interface.
LIBC_LAX_CFLAGS	?=
LAX_CFLAGS	:= $(if $(filter 1,$(LAX)),$(LIBC_LAX_CFLAGS))

# ----- Generated by lcrun from spec/ -----
# LC_STD_CFLAGS LC_EXT_CFLAGS LC_UNITS LC_EXT_UNITS
# LC_PROBES_LINK (functions, variables: compiled and linked)
# LC_PROBES_DECL (macros, types: compiled only)
# LC_PROBES_HIDDEN (strict mode: must not be visible, compiled only)
# LC_PROBES_REJECT (must not compile: K.3.1.1p4, ...)
# LC_DEFS_<cat> (the types and macros of <cat> the target requires, for <cat>/defs)

SPEC_MK		:= $(OUT)/spec.mk
NO_SPEC_GOALS := clean fclean help standards options new init format \
	headers-add headers-check sources-check spec-list spec-check matrix todo run-all \
	cache-clean

ifeq ($(filter $(NO_SPEC_GOALS),$(MAKECMDGOALS)),)
include $(SPEC_MK)
endif

# Regenerated when lcrun, a spec or a unit changes, but rewritten only
# if its content changed: every unit depends on it (through its command
# file), so an unchanged spec.mk must keep its date. The stamp records
# when it was last checked.
lc_spec_gen	= mkdir -p $(OUT) && \
	$(RUNNER) $(LCTARGET) $(LCPATHS) --spec-make > $(SPEC_MK).tmp && \
	$(call lc_update,$(SPEC_MK).tmp,$(SPEC_MK))

$(SPEC_MK).stamp: $(RUNNER) $(SPECS) $(SUITES)
	@$(lc_spec_gen)
	@touch $@

$(SPEC_MK): $(SPEC_MK).stamp
	@test -f $@ || { $(lc_spec_gen); }

# ----- Filtered by CAT / FUNC -----

lc_by_cat	= $(if $(CAT),$(filter $(addsuffix /%,$(subst $(comma), ,$(CAT))),$(1)),$(1))
# <cat>/defs holds several symbols: kept, lcrun filters its tests by FUNC.
lc_by_func	= $(if $(FUNC),$(filter $(addprefix %/,$(subst $(comma), ,$(FUNC)) defs),$(1)),$(1))
lc_select	= $(call lc_by_func,$(call lc_by_cat,$(1)))

# Only the units listed in suites.mk are built.
UNITS		:= $(filter $(SUITE_UNITS),$(call lc_select,$(LC_UNITS)))
BINS		:= $(addprefix $(OUT)/bin/,$(UNITS))
PROBES		:= $(if $(filter 1,$(PROBE)),$(call lc_select,$(LC_PROBES_LINK) $(LC_PROBES_DECL)))
HIDDEN		:= $(if $(filter 1,$(PROBE)),$(call lc_select,$(LC_PROBES_HIDDEN)))
REJECT		:= $(if $(filter 1,$(PROBE)),$(call lc_by_cat,$(LC_PROBES_REJECT)))
PROBE_OUT	:= $(addprefix $(OUT)/probe/,$(addsuffix .status,$(PROBES))) \
	$(addprefix $(OUT)/probe/,$(addsuffix .hidden,$(HIDDEN))) \
	$(addprefix $(OUT)/probe/,$(addsuffix .reject,$(REJECT)))
