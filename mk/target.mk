# target.mk - the target (what the libc is checked against) and what it
# selects: feature-test macros, units, probes.
#
#   STD=posix-2024   c99 c11 c17 c23 posix-2001 posix-2008 posix-2017 posix-2024
#   OPTS=XSI         option groups, comma list (make options): POSIX ones
#                    (XSI, TSF, ...; only on a POSIX target, default XSI) and
#                    ISO C conditional features (THREADS, COMPLEX, LIB_EXT1, ...)
#   EXT=0            1: also the extensions (GNU, BSD) listed in spec/
#   CAT=a,b FUNC=f   only these categories / functions

LIBC		?= host
STD			?= posix-2024
OPTS		?= $(if $(filter posix-%,$(STD)),XSI)
EXT			?= 0
PROBE		?= 1
COV			?= 0

TARGET		:= $(STD)$(if $(OPTS),+$(subst $(comma),+,$(OPTS)))$(if $(filter 1,$(EXT)),+ext)
OUT			:= $(BUILD_DIR)/$(LIBC)/$(TARGET)
LCTARGET	:= -S $(STD) $(if $(OPTS),-O $(OPTS)) $(if $(filter 1,$(EXT)),-E)
LCPATHS		:= -s $(SUITES_DIR) -p $(SPEC_DIR)

# The libc profile (LIBC_CC, LIBC_CPPFLAGS, ..., libc-prepare).
ifeq ($(wildcard mk/libc/$(LIBC).mk),)
$(error LIBC=$(LIBC): no profile mk/libc/$(LIBC).mk (have: $(basename $(notdir $(wildcard mk/libc/*.mk)))))
endif
include mk/libc/$(LIBC).mk

# ----- Generated by lcrun from spec/ -----
# LC_STD_CFLAGS LC_EXT_CFLAGS LC_UNITS LC_EXT_UNITS
# LC_PROBES_LINK (functions, variables: compiled and linked)
# LC_PROBES_DECL (macros, types: compiled only)

SPEC_MK		:= $(OUT)/spec.mk
NO_SPEC_GOALS := clean fclean help standards options new init format \
	headers-add headers-check spec-list spec-check matrix todo run-all

ifeq ($(filter $(NO_SPEC_GOALS),$(MAKECMDGOALS)),)
include $(SPEC_MK)
endif

$(SPEC_MK): $(RUNNER) $(SPECS) $(SUITES)
	@mkdir -p $(@D)
	@$(RUNNER) $(LCTARGET) $(LCPATHS) --spec-make > $@.tmp && mv $@.tmp $@

# ----- Filtered by CAT / FUNC -----

lc_by_cat	= $(if $(CAT),$(filter $(addsuffix /%,$(subst $(comma), ,$(CAT))),$(1)),$(1))
lc_by_func	= $(if $(FUNC),$(filter $(addprefix %/,$(subst $(comma), ,$(FUNC))),$(1)),$(1))
lc_select	= $(call lc_by_func,$(call lc_by_cat,$(1)))

UNITS		:= $(call lc_select,$(LC_UNITS))
BINS		:= $(addprefix $(OUT)/bin/,$(UNITS))
PROBES		:= $(if $(filter 1,$(PROBE)),$(call lc_select,$(LC_PROBES_LINK) $(LC_PROBES_DECL)))
PROBE_OUT	:= $(addprefix $(OUT)/probe/,$(addsuffix .status,$(PROBES)))
